{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/google-merchant-feed.xml", "destination": "/api/sitemap?type=merchant" },
    { "source": "/mercedes-actros-fren-diski", "destination": "/api/sitemap?type=landing&slug=mercedes-actros-fren-diski" },
    { "source": "/mercedes-axor-fren-diski", "destination": "/api/sitemap?type=landing&slug=mercedes-axor-fren-diski" },
    { "source": "/mercedes-atego-fren-diski", "destination": "/api/sitemap?type=landing&slug=mercedes-atego-fren-diski" },
    { "source": "/man-tga-fren-diski", "destination": "/api/sitemap?type=landing&slug=man-tga-fren-diski" },
    { "source": "/man-tgs-tgx-fren-diski", "destination": "/api/sitemap?type=landing&slug=man-tgs-tgx-fren-diski" },
    { "source": "/volvo-fh-fren-diski", "destination": "/api/sitemap?type=landing&slug=volvo-fh-fren-diski" },
    { "source": "/scania-bijon", "destination": "/api/sitemap?type=landing&slug=scania-bijon" },
    { "source": "/ford-cargo-fren-kampanasi", "destination": "/api/sitemap?type=landing&slug=ford-cargo-fren-kampanasi" },
    { "source": "/renault-premium-fren-parcalari", "destination": "/api/sitemap?type=landing&slug=renault-premium-fren-parcalari" },
    { "source": "/bpw-dorse-fren-kampanasi", "destination": "/api/sitemap?type=landing&slug=bpw-dorse-fren-kampanasi" },
    { "source": "/saf-dorse-porya-kapagi", "destination": "/api/sitemap?type=landing&slug=saf-dorse-porya-kapagi" },
    { "source": "/krone-dorse-fren-parcalari", "destination": "/api/sitemap?type=landing&slug=krone-dorse-fren-parcalari" },
    { "source": "/agir-vasita-otomatik-fren-circiri", "destination": "/api/sitemap?type=landing&slug=agir-vasita-otomatik-fren-circiri" },
    { "source": "/agir-vasita-mekanik-fren-circiri", "destination": "/api/sitemap?type=landing&slug=agir-vasita-mekanik-fren-circiri" },
    { "source": "/agir-vasita-kaliper-tamir-takimi", "destination": "/api/sitemap?type=landing&slug=agir-vasita-kaliper-tamir-takimi" },
    { "source": "/knorr-wabco-kaliper-tamir-takimi", "destination": "/api/sitemap?type=landing&slug=knorr-wabco-kaliper-tamir-takimi" },
    { "source": "/abs-sensoru-ebs-modulator", "destination": "/api/sitemap?type=landing&slug=abs-sensoru-ebs-modulator" },
    { "source": "/agir-vasita-fren-korugu", "destination": "/api/sitemap?type=landing&slug=agir-vasita-fren-korugu" },
    { "source": "/agir-vasita-suspansiyon-korugu", "destination": "/api/sitemap?type=landing&slug=agir-vasita-suspansiyon-korugu" },
    { "source": "/agir-vasita-fren-balatasi", "destination": "/api/sitemap?type=landing&slug=agir-vasita-fren-balatasi" },
    { "source": "/dorse-bijon-somun", "destination": "/api/sitemap?type=landing&slug=dorse-bijon-somun" },
    { "source": "/ekersan-fren-diski", "destination": "/api/sitemap?type=landing&slug=ekersan-fren-diski" },
    { "source": "/porya-kapagi", "destination": "/api/sitemap?type=landing&slug=porya-kapagi" },
    { "source": "/api/auth/:action", "destination": "/api/auth?action=:action" },
    { "source": "/api/admin/:action", "destination": "/api/admin?action=:action" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/admin.html", "destination": "/admin.html" },
    { "source": "/data/(.*)", "destination": "/data/$1" },
    { "source": "/img/(.*)", "destination": "/img/$1" },
    { "source": "/raporlar/(.*)", "destination": "/raporlar/$1" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/favicon.svg", "destination": "/favicon.svg" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(png|webp|jpg|jpeg|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=2592000" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    }
  ],
  "crons": []
}
